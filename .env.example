# 主体模型：支持 OpenAI Chat Completions 的接口
ASTCHO_WORLD_MODEL=your-model
ASTCHO_WORLD_API_KEY=your-api-key
ASTCHO_WORLD_BASE_URL=https://your-provider.example/v1
ASTCHO_WORLD_RUNNER=dsh
ASTCHO_WORLD_CONTEXT_WINDOW=65536
ASTCHO_WORLD_MAX_TOKENS=8192

# 改成你自己的管理员 QQ 和允许使用的群号，多个用逗号分隔
ASTCHO_ADMINS=10004
ASTCHO_ALLOWED_GROUPS=10003

# 原聊天后端。可以与主体使用同一接口，也可以分别配置
ASTCHO_LLM_API_KEY=your-api-key
ASTCHO_LLM_BASE_URL=https://your-provider.example/v1
ASTCHO_CHAT_MODEL=your-model
ASTCHO_PLANNER_MODEL=your-model
ASTCHO_REASONING_ENABLED=false

# 图片需要单独配置支持视觉的模型
ASTCHO_VISION_MODEL=your-vision-model
ASTCHO_VISION_API_KEY=your-vision-api-key
ASTCHO_VISION_BASE_URL=https://your-vision-provider.example/v1

ASTCHO_PROFILE_PATH=config/profile.local.json
ASTCHO_SCHEDULE_PATH=config/schedule.local.json
ASTCHO_WORLD_DATA_DIR=var
ASTCHO_WORLD_SKILLS_PATH=examples/skills
ASTCHO_MEMORY_ENABLED=false
ASTCHO_EXPRESSION_LEARNING=false

# NapCat 使用同一个 token；留空则不启用 WS token 校验
ONEBOT_ACCESS_TOKEN=
# Docker 中的 NapCat 需要让主机地址可达时再改监听地址
ASTCHO_WORLD_HOST=127.0.0.1

# 空闲周期约 2～10 分钟。将 ADAPTIVE_WAKE 设为 0 可关闭周期，事件唤醒继续工作
ASTCHO_WORLD_ADAPTIVE_WAKE=1
ASTCHO_WORLD_WAKE_MIN_SECONDS=120
ASTCHO_WORLD_WAKE_MAX_SECONDS=600
ASTCHO_WORLD_ACTIVITY_CONTEXT=1
ASTCHO_WORLD_RECENT_ACTIVITIES=10
ASTCHO_WORLD_MUTE_GROUPS=1

# B站是可选应用，先安装独立依赖，再设为 1
ASTCHO_WORLD_BILIBILI=0

# 网页搜索单独使用 DeepSeek 官方密钥；网页读取不需要它
DEEPSEEK_API_KEY=

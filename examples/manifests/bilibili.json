      },
      "history": {
        "kind": "activity.phone",
        "label": "正在回看浏览记录",
        "fallback": "base.idle",
        "hold_seconds": 20
      }
    }
  },
  "notification_tool": null,
  "events": [],
  "ambient_schema": {
    "type": "object",
    "properties": {
      "logged_in": {
        "type": "boolean"
      },
      "available": {
        "type": "boolean"
      },
      "asr": {
        "type": "boolean"
      }
    },
    "required": [
      "logged_in",
      "available",
      "asr"
    ],
    "additionalProperties": false
  },
  "admin_tools": [
    "account"
  ]
}
